# Edição exclusiva de salas. Valores secretos ficam no .env local ou no cofre da hospedagem.
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=
DATABASE_PATH=.data/rooms.sqlite
# simulated: demonstração identificada. api: fornecedor/gateway com contrato v2 confirmado.
ROOMS_PROVIDER=simulated
ROOMS_API_CONTRACT=
ROOMS_API_URL=
ROOMS_API_KEY=
ROOMS_API_AUTH_SCHEME=Bearer
ROOMS_API_TIMEOUT_MS=10000
# Heartbeat local da hospedagem; precisa ser gravável pelo processo.
ROOMS_HEALTH_FILE=/tmp/ff-salas-health.json
# Diagnóstico opcional no host do emulador; não habilita criação automatizada.
ROOMS_ADB_PATH=adb
ROOMS_ANDROID_SERIAL=
ROOMS_ANDROID_PACKAGE=com.dts.freefireth
# Respeita o proxy configurado pela hospedagem, preservando TLS.
NODE_USE_ENV_PROXY=1
